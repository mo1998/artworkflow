{
  "_artworkflow": {
    "name": "flux_txt2img",
    "description": "FLUX.1 text-to-image, 1 batch, one image per prompt. API-format graph with a binding map so the pipeline can inject per-asset parameters without editing the graph.",
    "version": 1,
    "requires": {
      "checkpoint": "flux1-dev-fp8.safetensors",
      "custom_nodes": []
    },
    "bindings": {
      "prompt": { "node": "2", "input": "text" },
      "negative_prompt": { "node": "3", "input": "text" },
      "guidance": { "node": "4", "input": "guidance" },
      "width": { "node": "5", "input": "width" },
      "height": { "node": "5", "input": "height" },
      "seed": { "node": "6", "input": "seed" },
      "steps": { "node": "6", "input": "steps" },
      "sampler": { "node": "6", "input": "sampler_name" },
      "scheduler": { "node": "6", "input": "scheduler" },
      "filename_prefix": { "node": "8", "input": "filename_prefix" }
    },
    "output_node": "8",
    "requires_positive_timestep": false
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "flux1-dev-fp8.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "FluxGuidance",
    "inputs": { "guidance": 3.2, "conditioning": ["2", 0] }
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 24,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["3", 0],
      "latent_image": ["5", 0]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["6", 0], "vae": ["1", 2] }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": { "images": ["7", 0], "filename_prefix": "artworkflow/asset" }
  }
}
